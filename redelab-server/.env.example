DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=troque_esta_senha
DB_NAME=redelab_escola
PORT=3000
# Use * apenas no desenvolvimento. Para múltiplas origens, separe por vírgulas.
CORS_ORIGIN=*
# Domínio do tenant sem caminho, por exemplo: meu-tenant.us.auth0.com
AUTH0_DOMAIN=
# Identifier da API criada no Auth0, por exemplo: https://api.redelab.local
AUTH0_AUDIENCE=
# Mantenha true somente no ambiente local. Também controla GET /api/dev/presenca.
ENABLE_DEV_ROUTES=true
