DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=troque_esta_senha
DB_NAME=redelab_escola

PORT=3000
HTTPS_ENABLED=false
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=

# Informe a origem exata da WebGL. Para múltiplas origens, separe por vírgulas.
CORS_ORIGIN=http://localhost:8081

# Domínio do tenant sem caminho, por exemplo: meu-tenant.us.auth0.com
AUTH0_DOMAIN=
# Identifier da API criada no Auth0, por exemplo: https://api.redelab.local
AUTH0_AUDIENCE=

# Use true somente no desenvolvimento local. Também controla GET /api/dev/presenca.
ENABLE_DEV_ROUTES=false

UNITY_WEBGL_PORT=8081
UNITY_WEBGL_HOST=127.0.0.1
UNITY_WEBGL_HTTPS_ENABLED=false
UNITY_WEBGL_HTTPS_KEY_PATH=
UNITY_WEBGL_HTTPS_CERT_PATH=
# Vazio usa a Build_WebGL do repositório. No servidor, prefira caminho absoluto.
UNITY_WEBGL_BUILD_DIR=
API_PUBLIC_URL=http://localhost:3000
WS_PUBLIC_URL=ws://localhost:3000
